{
  "name": "nuxt-bundle-analyzer",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.0.0",
  "description": "See what ends up in your Nuxt bundles: pages, chunks, duplicate packages, circular imports, and what changed between two builds.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "default": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nuxt-bundle-analyzer": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --filter viewer generate && tsdown && node scripts/copy-ui.mjs",
    "dev:viewer": "pnpm --filter viewer dev",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm --filter viewer typecheck",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "nuxt": "^3.17.0 || ^4.0.0"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.3",
    "exsolve": "^1.0.8",
    "pathe": "^2.0.3",
    "sonda": "^0.14.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@nuxt/schema": "^4.6.3",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "jose": "^6.2.15",
    "nuxt": "^4.6.3",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
